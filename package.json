{
  "name": "twinbyte-site",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/prerender-meta.mjs && node scripts/showcase-i18n.mjs && node scripts/check-placeholders.mjs",
    "preview": "vite preview",
    "test": "node --experimental-strip-types --test tests/slots.test.ts tests/mail.test.ts",
    "dev:api": "npm run build && npx -y wrangler@4 pages dev dist --compatibility-date 2026-09-01"
  },
  "dependencies": {
    "preact": "^10.29.8",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.6.1",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "vite": "^5.4.21"
  }
}
